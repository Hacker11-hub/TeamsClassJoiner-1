
    <Window x:Class="TeamsClassJoiner.Views.AddClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Class"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <TextBlock Text="Class Name"
                   Grid.Row="0"
                   FontWeight="Bold"/>

        <TextBox x:Name="ClassNameTextBox"
                 Grid.Row="1"
                 Height="35"
                 Margin="0,5,0,15"/>


        <TextBlock Text="Day"
                   Grid.Row="2"
                   FontWeight="Bold"/>

        <ComboBox x:Name="DayComboBox"
                  Grid.Row="3"
                  Height="35"
                  Margin="0,5,0,15"/>


        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock Text="Start Time"
                           FontWeight="Bold"/>

                <TextBox x:Name="StartTimeTextBox"
                         Height="35"
                         Margin="0,5,0,0"/>

            </StackPanel>


            <StackPanel Grid.Column="2">

                <TextBlock Text="End Time"
                           FontWeight="Bold"/>

                <TextBox x:Name="EndTimeTextBox"
                         Height="35"
                         Margin="0,5,0,0"/>

            </StackPanel>

        </Grid>


        <TextBlock Text="Teams Meeting URL"
                   Grid.Row="5"
                   FontWeight="Bold"
                   Margin="0,20,0,0"/>

        <TextBox x:Name="TeamsUrlTextBox"
                 Grid.Row="6"
                 Height="80"
                 Margin="0,5,0,0"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"/>


        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <CheckBox x:Name="EnabledCheckBox"
                      Content="Enabled"
                      IsChecked="True"
                      VerticalAlignment="Center"
                      Margin="0,0,20,0"/>

            <Button Content="Cancel"
                    Width="90"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Width="90"
                    Height="35"
                    Click="Save_Click"/>

        </StackPanel>

    </Grid>

</Window>